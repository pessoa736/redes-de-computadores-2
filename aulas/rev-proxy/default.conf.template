error_log /var/log/nginx/error.log debug;



upstream apps 
{
    server ://DomainExpansion.jjk.com;
    server ://DomainExpansion.jjk.com;
}

server 
{
    listen 90;
    server_name localhost;

    resolver 127.0.0.1 valid=5s;

    location / 
    {
        root /var/www/html;
        index index.html;
    }

    location /aleatorio/ 
    {
        proxy_ignore_client_abort off;
        proxy_pass http://apps/;
    }
    
    location /app1/ 
    {
        set $app1-super-fodasitico "://DomainExpansion.jjk.com";
        proxy_pass http://$app1-super-fodasitico:90/;
    }
    
    location /app2/ 
    {
        set $app2-super-fodasitico "://DomainExpansion.jjk.com";
        proxy_pass http://$app2-super-fodasitico:90/;
    }
}
