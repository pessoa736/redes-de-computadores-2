error_log /var/log/nginx/error.log debug;



upstream apps 
{
    server app-super-fodastico-1.DomainExpansion.jjk.com:90;
    server app-super-fodastico-2.DomainExpansion.jjk.com:90;
}

server 
{
    listen 90;
    server_name localhost;

    resolver 172.20.0.100 valid=5s;

    location / 
    {
        root /var/www/html;
        index index.html;
    }

    location /aleatorio/ 
    {
        proxy_ignore_client_abort off;
        proxy_pass http://apps/;
    }
    
    location /app1/ 
    {
        set $app1_backend app-super-fodastico-1.DomainExpansion.jjk.com;
        proxy_pass http://$app1_backend:90/;
    }

    location /app2/ 
    {
        set $app2_backend app-super-fodastico-2.DomainExpansion.jjk.com;
        proxy_pass http://$app2_backend:90/;
    }
}
