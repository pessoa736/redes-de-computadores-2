error_log /etc/nginx/logs/erro.log;


upstream apps {
    server app1:90 weight=1;
    server app2:90 weight=1;
}



server {
    listen 90;
    server_name localhost;


    location / {
        root /var/www/html;
        index index.html;
    }



    location /aleatorio/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_pass http://apps/;
    }

    
    location /app1/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_pass http://app1:90/;
    }
    
    location /app2/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        proxy_pass http://app2:90/;
    }
}