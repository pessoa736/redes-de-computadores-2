error_log /var/log/nginx/error.log debug;



upstream apps 
{
    server app-super-fodastico-1.DomainExpansion.com:90;
    server app-super-fodastico-2.DomainExpansion.com:90;
}

server 
{
    listen 90;
    ssi on;

    resolver 172.20.0.100 valid=5s;

    location / 
    {
        root /var/www/html;
        index index.html;
    }

    location /aleatorio/ 
    {
        proxy_ignore_client_abort off;
        proxy_pass http://apps/;
    }
    
    location /app1/ 
    {
        proxy_pass http://app-super-fodastico-1.DomainExpansion.com:90/;
    }

    location /app2/ 
    {
        proxy_pass http://app-super-fodastico-2.DomainExpansion.com:90/;
    }



    location ~ ^/ns1/(?<svc>[^/]+)/?(?<resto>.*)$
    {
        resolver 172.20.0.100 valid=5s;
        proxy_set_header X-Resolvido-Por "ns1";
        add_header X-Resolvido-Por "ns1" always;
        proxy_pass http://$svc.DomainExpansion.com:90/$resto$is_args$args;
    }

    location ~ ^/ns2/(?<ini>[^/]*?)super(?<fim>[^/]*)/?(?<resto>.*)$
    {
        resolver 172.20.0.101 valid=5s;
        proxy_set_header X-Resolvido-Por "ns2";
        add_header X-Resolvido-Por "ns2" always;
        proxy_pass http://${ini}hyper${fim}.DomainExpansion.com:90/$resto$is_args$args;
    }
}
