
server {
    listen       80;
    server_name localhost;

    location / {
       root /var/www/html;
       index index.html; 
    }

    location /herestoyou-server/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://herestoyou:80/;
    }
}